# ================================
# AWS 設定
# ================================

# AssumeRole 先のロール ARN（CDK デプロイ後に出力された値）
ROLE_ARN=arn:aws:iam::590184009554:role/OnPremSqlBridgeRole

# SQS リクエストキュー URL（CDK 出力: RequestQueueUrl）
REQUEST_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/590184009554/onprem-sql-request

# SQS レスポンスキュー URL（CDK 出力: ResponseQueueUrl）
RESPONSE_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/590184009554/onprem-sql-response

# S3 結果バケット名（CDK 出力: ResultBucketName）
RESULT_BUCKET=onprem-sql-result-590184009554-ap-northeast-1

# SNS アラートトピック ARN（CDK 出力: AlertTopicArn）任意
ALERT_TOPIC_ARN=arn:aws:sns:ap-northeast-1:590184009554:OnPremSqlBridgeAlerts

# AWS リージョン
AWS_REGION=ap-northeast-1

# STS セッション有効秒数（最大 3600）
SESSION_DURATION_SEC=3600

# セッション期限 N 分前に再取得
SESSION_REFRESH_BUFFER_MIN=5

# SQS Long Polling 待機秒数（0〜20）
SQS_WAIT_TIME_SECONDS=10

# SELECT 結果の最大バイト数（デフォルト 8 MB）
MAX_RESULT_BYTES=8388608

# ================================
# Oracle 設定
# ================================

# デフォルト接続先 Oracle DSN（ODBC データソース名）
# TNS 名はメッセージ本文の "tns" フィールドで切り替え可能
ORACLE_DSN=YourOracleDSN

# Oracle 接続ユーザー
ORACLE_USER=dbuser

# Oracle 接続パスワード（本番環境では AWS Secrets Manager 等を使用すること）
ORACLE_PASSWORD=dbpass

# ================================
# ネットワーク設定
# ================================

# HTTPS プロキシ URL（プロキシなし環境では空にする）
PROXY_URL=http://proxy.company.local:8080

# ================================
# セキュリティ設定
# ================================

# 許可する app_id ホワイトリスト（カンマ区切り）
ALLOWED_APP_IDS=app1,app2,app3

# ================================
# ログ設定
# ================================

# ログレベル（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# ================================
# モック設定
# ================================

# true にすると Oracle に接続せずダミーデータを S3 に保存する
# テスト・疎通確認用。本番運用時は false (または削除)
MOCK_MODE=false
